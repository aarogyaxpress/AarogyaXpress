# Supabase client-side project URL and publishable/anon key (safe for browser use).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Server-side Supabase access. Never add the service role key to a VITE_ variable.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# AI_PROVIDER=groq uses Groq for text and image analysis; PDF analysis still needs Gemini.
AI_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=qwen/qwen3.8-27b

# Optional: used for PDF analysis and as an alternative provider.
GEMINI_API_KEY=your-new-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
